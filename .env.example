# Panta API Configuration
PANTA_API_KEY=pk_test_your_panta_api_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_USERNAME=YourBotUsername

# Mini App URL (must be HTTPS for Telegram)
# Set this to your deployed URL (e.g., https://pantapredict.onrender.com)
TELEGRAM_MINIAPP_URL=https://localhost:8000

# Optional: Force IPv4 for environments where IPv6 fails
# Set to 1 to enable, 0 or leave unset to use system default
FORCE_IPV4=0
